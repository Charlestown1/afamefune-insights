# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mmuo?retryWrites=true&w=majority

# Long random string used to sign admin session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# The ONLY email allowed to log into /admin
ADMIN_EMAIL=charlesafamefune@gmail.com

# Bcrypt hash of the admin password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Set to "production" on Render
NODE_ENV=development

# Full public URL of the deployed site (used for SEO metadata, canonical URLs)
PUBLIC_URL=https://mmuo.onrender.com
