# ============================================================
# Afamefune Insights — environment variables
# Copy this file to .env for local development, or set these
# as environment variables in your Render dashboard for production.
# NEVER commit a real .env file with actual secrets to git.
# ============================================================

# --- Required: Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# --- Required: Sessions ---
SESSION_SECRET=replace_with_a_long_random_string

# --- Required: Google OAuth ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Required: AI Mentor (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Required for live prices: Twelve Data ---
# Free plan: 8 credits/minute, 800 credits/day. See public/index.html
# Settings view and server.js comments for how the app budgets this.
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# --- Optional: tune live-price polling (milliseconds) ---
# Core 5 instruments (dashboard + TP/SL monitoring). Default 600000 (10 min).
MARKET_POLL_INTERVAL_MS=600000
# Extended 13 instruments (Markets page only). Default 14400000 (4 hours).
EXTENDED_MARKET_POLL_INTERVAL_MS=14400000

# --- Optional: promote an account to admin automatically on login/signup ---
ADMIN_EMAIL=you@example.com

# --- Optional: BNB Smart Chain donation address override ---
# If unset, defaults to the address already hard-coded in server.js.
DONATION_BSC_ADDRESS=0x1B7f1D6AFa15979C40564e7cc66084082c7483C1

# --- Optional: Economic Calendar (Phase 4) ---
# Provider: Financial Modeling Prep (financialmodelingprep.com). Sign up for
# a free "Basic" API key. Real macro events only (CPI, NFP, rate decisions,
# GDP, etc. for USD/GBP/EUR/JPY/CAD/AUD/NZD/CHF) — if this key is unset, the
# Economic Calendar page says so plainly and shows nothing fabricated.
FMP_API_KEY=
# How often to refresh the calendar (ms). Default 1800000 = 30 minutes.
ECONOMIC_CALENDAR_POLL_INTERVAL_MS=1800000

# --- Optional: enables "no URL bar" Android TWA experience ---
# Get this from `keytool -list -v -keystore android.keystore -alias afamefune`
# after building the Android package (see android-twa/README-ANDROID.md).
ANDROID_APK_SHA256_FINGERPRINT=

# --- Set automatically by Render — do not set manually in production ---
# PORT=3000
# NODE_ENV=production
